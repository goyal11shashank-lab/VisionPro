# ==============================================================================
# NETLIFY DATABASE (PostgreSQL) CONFIGURATION
# ==============================================================================
# In production on Netlify, NETLIFY_DB_URL is injected automatically by Netlify Database.
# Note: Use the PostgreSQL READ & WRITE connection URL (not the read-only URL)
# because the ERP performs INSERT, UPDATE, and DELETE operations across all modules.

# Primary Netlify Database URL (injected automatically in Netlify production environments):
NETLIFY_DB_URL=

# Secondary Netlify Database URL alias (if configured in environment):
NETLIFY_DATABASE_URL=

# Optional local/container fallback connection string:
DATABASE_URL=

# ==============================================================================
# SERVER-SIDE SECRETS (Never exposed to browser or client bundle)
# ==============================================================================
# JWT_SECRET: Secret key for signing and verifying JSON Web Tokens
JWT_SECRET=

# GEMINI_API_KEY: Optional server-side API key for AI capabilities
GEMINI_API_KEY=


