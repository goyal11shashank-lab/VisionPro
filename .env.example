# Neon Project: VisionPro (lucky-pond-04653281)
# Neon Organization: goyal11shashank@gmail.com (org-silent-cake-60280313)
#
# Primary PostgreSQL connection URL (Pooled connection for application):
# (e.g. postgresql://user:password@ep-lucky-pond-04653281-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require)
DATABASE_URL=

# Direct / Unpooled Connection URL (for migrations, Drizzle Kit, schema generation):
# (e.g. postgresql://user:password@ep-lucky-pond-04653281.us-east-2.aws.neon.tech/neondb?sslmode=require)
DATABASE_URL_UNPOOLED=

# Development Database URL (prioritized during local development when DEV_DATABASE_URL is set):
DEV_DATABASE_URL=

# Neon API Key (for Neon CLI, MCP server, and management SDK):
NEON_API_KEY=

# Port for Node.js Web App (defaults to 3000):
PORT=3000

# Legacy / Netlify Database URL aliases (supported for Netlify environments):
NETLIFY_DB_URL=
NETLIFY_DATABASE_URL=

# ==============================================================================
# SERVER-SIDE SECRETS (Never exposed to browser or client bundle)
# ==============================================================================
# JWT_SECRET: Secret key for signing and verifying JSON Web Tokens
JWT_SECRET=

# GEMINI_API_KEY: Optional server-side API key for AI capabilities
GEMINI_API_KEY=


