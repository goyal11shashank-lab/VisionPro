# DATABASE_URL: PostgreSQL connection string (Netlify Database, Neon, Supabase, Cloud SQL, or local PostgreSQL)
# Example: postgresql://username:password@hostname:5432/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/optical_erp"

# JWT_SECRET: Secret key for signing and verifying JSON Web Tokens for user sessions
JWT_SECRET="replace-with-a-secure-random-secret-key-for-production"

# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

